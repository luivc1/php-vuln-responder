# =====================================================================
#  Advisory file: the single source of truth for every script and skill.
#  To respond to a future PHP vulnerability, copy this file, change the
#  values, and pass it with --advisory <file> (or set it as DEFAULT below
#  in scripts/lib.sh). Plain KEY="value" so bash can source it and an LLM
#  can read it.
# =====================================================================

ADVISORY_ID="php2shell-2026-10"
ADVISORY_NAME="PHP2Shell"
CVES="CVE-2026-109618 CVE-2026-109619"
SEVERITY="Critical (CVSS v4.0 9.2), unauthenticated remote code execution"
COMPONENT="PHP interpreter core (affects every app on a vulnerable PHP: WordPress, Drupal, Magento, Joomla, Laravel...)"
AFFECTED_SAPIS="PHP-FPM, Apache mod_php, php-cgi, FrankenPHP, LiteSpeed (any PHP serving web requests)"

# First patched upstream release per supported branch (space separated).
FIXED_VERSIONS="8.5.12 8.4.27 8.3.36 8.2.35"

# Branches older than this get no official fix (end of life).
EOL_BELOW="8.2"

# Dates (UTC). LEAK_DATE is when exploitation could have started: hunt for
# compromise from this date onward on any host that was exposed.
LEAK_DATE="2026-10-20"
PATCH_DATE="2026-10-21"
IOC_SINCE="2026-10-19"

# Official position on workarounds. Agents must repeat this, not invent fixes.
MITIGATION_NOTE="Upgrading PHP is the only real fix. Disabling session.upload_progress or setting session.use_only_cookies=On is partial hardening at best and does not cover every attack path. Unpatchable internet-facing hosts should be isolated (offline, VPN, or strict WAF) until upgraded."

# Log heuristic (community analysis, NOT confirmed by PHP). Matches are
# leads to investigate, not proof of compromise.
LOG_HEURISTIC_REGEX="PHP_SESSION_UPLOAD_PROGRESS"

SOURCES="https://www.php.net | https://www.helpnetsecurity.com/2026/10/21/php2shell-php-vulnerabilities-patched-cve-2026-109618-cve-2026-109619/ | https://www.ncsc.gov.uk/news/critical-security-issue-affecting-php | https://thehackernews.com/2026/10/php2shell-what-actually-protects-you.html"
LAST_VERIFIED="2026-10-21"
